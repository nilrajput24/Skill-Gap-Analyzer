APP_NAME="Student Skill Gap Analyzer"
ENVIRONMENT="development"

# Database Connection:
# 1. Local Windows Development - Microsoft SQL Server 2022 (Windows Authentication):
DATABASE_URL="mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3D.%5CSQLEXPRESS%3BDATABASE%3DStudentSkillGapAnalyzer%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes%3B"

# 2. Local Windows Development - Microsoft SQL Server 2022 (SQL Authentication):
# DATABASE_URL="mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3D.%5CSQLEXPRESS%3BDATABASE%3DStudentSkillGapAnalyzer%3BUID%3Dyour_username%3BPWD%3Dyour_password%3BTrustServerCertificate%3Dyes%3B"

# 3. Cloud Production - Remote Managed SQL Server (Azure SQL / AWS RDS):
# DATABASE_URL="mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3Dyour-server.database.windows.net%2C1433%3BDATABASE%3DStudentSkillGapAnalyzer%3BUID%3Dcloud_admin%3BPWD%3DStrongPassword!%3BEncrypt%3Dyes%3BTrustServerCertificate%3Dno%3BConnection+Timeout%3D30%3B"

# 4. Cloud Production - Render PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/dbname"

# JWT Authentication (7-day default session expiry):
JWT_SECRET="replace_with_a_long_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_ORIGIN="http://localhost:5173"

# Optional Email / Password Reset Service (SMTP):
# When omitted, reset links print to backend server logs in development.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM_EMAIL="noreply@skillanalyzer.dev"
